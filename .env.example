# Copy this file to .env and put your key after the equals sign:
#
#     cp .env.example .env
#
# .env is gitignored: never commit it, and never paste a key into config.toml
# or into key_env. The real environment wins if both are set.
#
# The name must match [llm] key_env in config.toml (default shown).
# For a user-wide file that works from any folder, run: --init-config
OPENROUTER_API_KEY=your-key-here
